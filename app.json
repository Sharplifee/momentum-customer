{
  "expo": {
    "name": "MomentumLAND",
    "slug": "momentum-customer",
    "scheme": "momentum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1720",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1720"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.momentumlandscapingut.customer",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Attach a photo when you message us about your yard.",
        "NSPhotoLibraryUsageDescription": "Attach a photo when you message us about your yard.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Momentum uses your location once to show the forecast for your own yard on service day. We never track you in the background.",
        "CFBundleDisplayName": "MomentumLAND"
      },
      "entitlements": {
        "com.apple.developer.weatherkit": true
      }
    },
    "android": {
      "package": "com.momentumlandscapingut.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1720"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7FB8BE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Momentum uses your location once to show the forecast for your own yard on service day."
        }
      ]
    ],
    "extra": {
      "portalUrl": "https://momentumlandscapingut.com/#app"
    }
  }
}